# syntax=docker/dockerfile:1
#
# Image used by internal/e2e tests. Differs from the production
# Dockerfile in three ways:
#   1. Bundles internal/plugin/testplugin so tests have a known plugin
#      binary at /usr/local/bin/talon-testplugin without needing a
#      bind-mount.
#   2. ENTRYPOINT/CMD split so a testcontainers Cmd: override
#      changes flags without re-templating the whole command.
#   3. mkdir /tmp/ws as a default workspace, since the chat handler
#      requires every agent to resolve to a real directory.
#
# Image is cached by docker; subsequent test runs only rebuild layers
# whose source bytes changed (typically zero on a hot loop).

FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/talon ./cmd/talon
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/talon-testplugin ./internal/plugin/testplugin
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/talon-deepseek-plugin ./apps/talon-deepseek-plugin
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/talon-telegram-plugin ./apps/talon-telegram-plugin

# ---- shim install (Node) -------------------------------------------------
# openclaw-plugin-host is a Node.js subprocess that loads existing
# openclaw extensions and bridges them to talon's gRPC Plugin service.
# Installed into a fixed location so plugins.entries.<name>.cmd can
# reference it without per-host path probing.
FROM node:20-alpine AS shim-install
WORKDIR /shim
COPY apps/openclaw-plugin-host/package.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund
COPY apps/openclaw-plugin-host/ ./

# ---- runtime --------------------------------------------------------------
FROM alpine:3.20
RUN apk add --no-cache ca-certificates coreutils bash nodejs \
    && mkdir -p /tmp/ws /root/.talon
COPY --from=build /out/talon /usr/local/bin/talon
COPY --from=build /out/talon-testplugin /usr/local/bin/talon-testplugin
COPY --from=build /out/talon-deepseek-plugin /usr/local/bin/talon-deepseek-plugin
COPY --from=build /out/talon-telegram-plugin /usr/local/bin/talon-telegram-plugin
COPY --from=shim-install /shim /opt/openclaw-plugin-host
# Stable wrapper so plugins.entries.<name>.cmd can be a single string.
RUN ln -s /opt/openclaw-plugin-host/bin/openclaw-plugin-host.mjs /usr/local/bin/openclaw-plugin-host

# Test fixtures (openclaw extensions used by internal/e2e tests).
COPY internal/e2e/fixtures /opt/test-fixtures

EXPOSE 18789
ENTRYPOINT ["talon"]
CMD ["gateway", "run", "--bind=lan", "--port=18789", "--auth=none", "--allow-unconfigured"]
